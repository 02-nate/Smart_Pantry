<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    tools:context=".ui.RecipeDetailActivity">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="@dimen/section_spacing">

            <TextView
                android:id="@+id/text_recipe_title"
                style="@style/Masthead"
                tools:text="Pap and Tomato Gravy" />

            <View style="@style/Hairline" />

            <LinearLayout style="@style/SectionBar">

                <TextView
                    style="@style/Text.Meta"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/header_ingredients" />

                <TextView
                    android:id="@+id/text_ingredients_detail"
                    style="@style/Text.Meta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="5 of 6 in pantry" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/container_ingredients"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/gutter_text"
                android:paddingBottom="@dimen/section_spacing" />

            <View style="@style/Hairline" />

            <LinearLayout style="@style/SectionBar">

                <TextView
                    style="@style/Text.Meta"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/header_method" />

                <TextView
                    android:id="@+id/text_method_detail"
                    style="@style/Text.Meta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="5 steps" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/container_steps"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/gutter_text" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>
