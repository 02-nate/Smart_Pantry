<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    tools:context=".ui.SettingsActivity">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:title="@string/title_settings" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                style="@style/Masthead"
                android:text="@string/display_settings" />

            <!-- Expiry -->
            <View style="@style/Hairline" />

            <LinearLayout style="@style/SectionBar">

                <TextView
                    style="@style/Text.Meta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/header_expiry" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/gutter_text"
                android:paddingBottom="@dimen/section_spacing">

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switch_highlight"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/setting_highlight_expiring"
                    android:textAppearance="@style/Text.Body" />

                <TextView
                    style="@style/Text.Meta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/setting_highlight_expiring_summary"
                    android:textColor="@color/text_muted" />
            </LinearLayout>

            <!-- Display units -->
            <View style="@style/Hairline" />

            <LinearLayout style="@style/SectionBar">

                <TextView
                    style="@style/Text.Meta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/header_display_units" />
            </LinearLayout>

            <RadioGroup
                android:id="@+id/radio_units"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="@dimen/gutter_text"
                android:paddingBottom="@dimen/section_spacing">

                <com.google.android.material.radiobutton.MaterialRadioButton
                    android:id="@+id/radio_base_units"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/units_base"
                    android:textAppearance="@style/Text.Body" />

                <com.google.android.material.radiobutton.MaterialRadioButton
                    android:id="@+id/radio_auto_scale"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/units_auto_scale"
                    android:textAppearance="@style/Text.Body" />
            </RadioGroup>

            <!-- Pantry data -->
            <View style="@style/Hairline" />

            <LinearLayout style="@style/SectionBar">

                <TextView
                    style="@style/Text.Meta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/header_pantry_data" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_clear_pantry"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/gutter_text"
                android:text="@string/action_clear_pantry" />

            <TextView
                android:id="@+id/text_about"
                style="@style/Text.Meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="@dimen/gutter_text"
                android:textColor="@color/text_muted"
                tools:text="Smart Pantry Manager · version 1.0" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <include
        android:id="@+id/bottom_nav_container"
        layout="@layout/view_bottom_nav" />

</LinearLayout>
