<?xml version="1.0" encoding="utf-8"?>
<!-- Inventory tile: name, zero-padded days-left numeral, then a hairline footer. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/card_pantry"
    style="@style/Widget.Pantry.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/card_gap"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="@color/bg_green">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/card_padding">

        <TextView
            android:id="@+id/text_name"
            style="@style/Text.ItemName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/name_to_number"
            tools:text="Tomatoes" />

        <TextView
            android:id="@+id/text_days"
            style="@style/Text.Days"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="02" />

        <View style="@style/Hairline" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="true"
            android:orientation="horizontal"
            android:paddingTop="@dimen/footer_padding_top">

            <TextView
                android:id="@+id/text_expiry_label"
                style="@style/Text.Meta"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/spacing_medium"
                android:layout_weight="1"
                tools:text="Expires soon · 22 Oct 2026" />

            <TextView
                android:id="@+id/text_quantity"
                style="@style/Text.Meta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="5 pcs" />
        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
