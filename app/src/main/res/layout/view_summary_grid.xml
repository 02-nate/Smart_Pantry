<?xml version="1.0" encoding="utf-8"?>
<!-- Two summary tiles (mint, lavender) at a 1:1.1 ratio. Labels and numbers are set in code. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/gutter_card"
    android:paddingEnd="@dimen/gutter_card"
    android:paddingBottom="@dimen/section_spacing">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/tile_left"
        style="@style/Widget.Pantry.Card"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginEnd="@dimen/half_card_gap"
        android:clickable="false"
        android:focusable="false"
        app:cardBackgroundColor="@color/bg_mint"
        app:layout_constraintDimensionRatio="1:1.1"
        app:layout_constraintEnd_toStartOf="@id/tile_right"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingHorizontal="@dimen/tile_padding_horizontal"
            android:paddingVertical="@dimen/tile_padding_vertical">

            <TextView
                android:id="@+id/tile_left_label"
                style="@style/Text.Meta"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:text="@string/tile_total_items" />

            <TextView
                android:id="@+id/tile_left_value"
                style="@style/Text.Stat"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                tools:text="11" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/tile_right"
        style="@style/Widget.Pantry.Card"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="@dimen/half_card_gap"
        android:clickable="false"
        android:focusable="false"
        app:cardBackgroundColor="@color/bg_lavender"
        app:layout_constraintDimensionRatio="1:1.1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/tile_left"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingHorizontal="@dimen/tile_padding_horizontal"
            android:paddingVertical="@dimen/tile_padding_vertical">

            <TextView
                android:id="@+id/tile_right_label"
                style="@style/Text.Meta"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:text="@string/tile_expiring_soon" />

            <TextView
                android:id="@+id/tile_right_value"
                style="@style/Text.Stat"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                tools:text="02" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>
