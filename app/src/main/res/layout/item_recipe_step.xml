<?xml version="1.0" encoding="utf-8"?>
<!-- One method step: zero-padded step number, then the instruction. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:baselineAligned="true"
    android:orientation="horizontal"
    android:paddingVertical="@dimen/spacing_medium">

    <TextView
        android:id="@+id/text_step_number"
        style="@style/Text.StepNumber"
        android:layout_width="@dimen/step_number_width"
        android:layout_height="wrap_content"
        tools:text="01" />

    <TextView
        android:id="@+id/text_step"
        style="@style/Text.Body"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        tools:text="Heat the oil in a pot and fry the chopped onion until soft." />

</LinearLayout>
