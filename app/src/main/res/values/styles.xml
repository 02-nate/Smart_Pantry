<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Type styles from DESIGN.md. Every style is bold; tracking is tight on large type and
        wide on micro-labels. The design specifies Inter Bold; until a font file is bundled
        the system sans-serif is used, so swapping fonts only means changing Text.Base.
        These styles double as text appearances (toolbar titles, bottom-nav labels).
    -->
    <style name="Text.Base" parent="">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_main</item>
    </style>

    <style name="Text.Display" parent="Text.Base">
        <item name="android:textSize">@dimen/text_display</item>
        <item name="android:letterSpacing">-0.03</item>
        <item name="android:lineSpacingMultiplier">0.9</item>
    </style>

    <style name="Text.Stat" parent="Text.Base">
        <item name="android:textSize">@dimen/text_stat</item>
        <item name="android:letterSpacing">-0.05</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="Text.Days" parent="Text.Base">
        <item name="android:textSize">@dimen/text_days</item>
        <item name="android:letterSpacing">-0.04</item>
    </style>

    <style name="Text.ItemName" parent="Text.Base">
        <item name="android:textSize">@dimen/text_item_name</item>
        <item name="android:letterSpacing">-0.02</item>
    </style>

    <style name="Text.Body" parent="Text.Base">
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>

    <style name="Text.StepNumber" parent="Text.Base">
        <item name="android:textSize">@dimen/text_step_number</item>
        <item name="android:letterSpacing">-0.04</item>
    </style>

    <style name="Text.Meta" parent="Text.Base">
        <item name="android:textSize">@dimen/text_meta</item>
        <item name="android:letterSpacing">0.1</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <style name="Text.NavLabel" parent="Text.Meta">
        <item name="android:letterSpacing">0.05</item>
        <item name="android:textColor">@color/nav_item</item>
    </style>

    <style name="Text.Button" parent="Text.Meta">
        <item name="android:textSize">@dimen/text_button</item>
    </style>

    <!-- Hairline divider (0.5dp). -->
    <style name="Hairline">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/hairline</item>
        <item name="android:background">@color/hairline</item>
    </style>

    <!-- Section title bar: two micro-labels at either end of a row. -->
    <style name="SectionBar">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:padding">@dimen/gutter_text</item>
    </style>

    <!-- Masthead title. The toolbar title above it acts as the eyebrow label. -->
    <style name="Masthead" parent="Text.Display">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingStart">@dimen/gutter_text</item>
        <item name="android:paddingEnd">@dimen/gutter_text</item>
        <item name="android:paddingBottom">@dimen/masthead_padding_bottom</item>
    </style>

    <!-- Flat 32dp tile used for every card. -->
    <style name="Widget.Pantry.Card" parent="Widget.Material3.CardView.Filled">
        <item name="cardCornerRadius">@dimen/radius_lg</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeWidth">0dp</item>
        <item name="strokeColor">@color/hairline</item>
        <item name="rippleColor">@color/ripple_subtle</item>
        <item name="android:stateListAnimator">@animator/card_press</item>
    </style>

    <style name="Widget.Pantry.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="android:background">@color/bg_white</item>
        <item name="titleTextAppearance">@style/Text.Meta</item>
        <item name="contentInsetStart">@dimen/gutter_text</item>
        <item name="navigationIconTint">@color/text_main</item>
    </style>

    <style name="Widget.Pantry.Button" parent="Widget.Material3.Button">
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:textAppearance">@style/Text.Button</item>
        <item name="android:textColor">@color/bg_white</item>
        <item name="backgroundTint">@color/bg_black</item>
        <item name="cornerRadius">@dimen/radius_lg</item>
        <item name="rippleColor">@color/hairline</item>
    </style>

    <style name="Widget.Pantry.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:textAppearance">@style/Text.Button</item>
        <item name="android:textColor">@color/text_main</item>
        <item name="cornerRadius">@dimen/radius_lg</item>
        <item name="strokeColor">@color/text_main</item>
        <item name="rippleColor">@color/ripple_subtle</item>
    </style>

    <style name="Widget.Pantry.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:textAppearance">@style/Text.Button</item>
        <item name="android:textColor">@color/text_main</item>
        <item name="rippleColor">@color/ripple_subtle</item>
    </style>

    <style name="Widget.Pantry.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/text_main</item>
        <item name="boxCornerRadiusTopStart">@dimen/radius_field</item>
        <item name="boxCornerRadiusTopEnd">@dimen/radius_field</item>
        <item name="boxCornerRadiusBottomStart">@dimen/radius_field</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/radius_field</item>
        <item name="hintTextColor">@color/text_main</item>
    </style>

    <style name="Widget.Pantry.TextInputLayout.Dropdown"
        parent="Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu">
        <item name="boxStrokeColor">@color/text_main</item>
        <item name="boxCornerRadiusTopStart">@dimen/radius_field</item>
        <item name="boxCornerRadiusTopEnd">@dimen/radius_field</item>
        <item name="boxCornerRadiusBottomStart">@dimen/radius_field</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/radius_field</item>
        <item name="hintTextColor">@color/text_main</item>
    </style>

    <style name="Widget.Pantry.BottomNav" parent="Widget.Material3.BottomNavigationView">
        <item name="android:background">@color/bg_white</item>
        <item name="labelVisibilityMode">labeled</item>
        <item name="itemIconSize">@dimen/nav_dot</item>
        <item name="itemTextAppearanceActive">@style/Text.NavLabel</item>
        <item name="itemTextAppearanceInactive">@style/Text.NavLabel</item>
        <item name="itemTextColor">@color/nav_item</item>
        <item name="itemRippleColor">@android:color/transparent</item>
    </style>

    <style name="ShapeAppearance.Pantry.Circle" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>
</resources>
